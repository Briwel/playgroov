// apps/backend/prisma/schema.prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model Track {
  id        String   @id @default(uuid())
  title     String
  artist    String?
  bpm       Float?
  key       String?
  filePath  String
  status    String   @default("IMPORTED") // IMPORTED, SPLITTING, SPLIT, TRANSCRIBING, READY
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
